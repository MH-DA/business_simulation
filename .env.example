# 복사해서 .env.local 로 만들어 사용한다. .env.local 은 커밋하지 않는다.
# 모든 키는 서버(API route)에서만 읽는다. NEXT_PUBLIC_ 접두사를 붙이지 말 것.

# LLM (둘 중 쓰는 쪽만 채운다)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 챗봇(5단계). 현재 코드는 Anthropic(Claude)만 연결되어 있다.
# LLM_MODEL=claude-sonnet-5-5
# 키 없이 화면 흐름만 볼 때는 stub (가짜 답변이 나온다, 실제 답변 품질과 무관)
# LLM_PROVIDER=stub

# true면 data/places 의 가짜 데이터를 사용한다 (개발 기본값)
# false면 아래 DB(snapshots 표)에 저장된 실제 수집 결과만 읽는다
USE_MOCK_DATA=true

# DB (Supabase PostgreSQL). 서버에서만 읽는다. 비밀번호가 들어 있으니 .env.local 에만 두고 절대 커밋·공유하지 않는다.
# Supabase 대시보드 → Connect → Session pooler 주소를 복사하고 [YOUR-PASSWORD] 자리에 DB 비밀번호를 넣는다.
DATABASE_URL=

# 6단계: FastAPI로 감싼 Python 수집기 주소
COLLECTOR_URL=http://localhost:8000
